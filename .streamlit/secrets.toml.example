# Copiá este archivo como .streamlit/secrets.toml y completá los valores.
# En producción (Streamlit Cloud) se cargan en el panel de "Secrets".
#
# ORDEN IMPORTANTE (TOML): las claves sueltas van SIEMPRE antes de cualquier
# sección entre corchetes. Todo lo que sigue a un `[encabezado]` pertenece a esa
# sección: si pegás `url_publica = ...` al final del archivo, termina dentro de
# `[gcp_service_account]` y la app no lo ve. Por eso la sección de Google va al
# final de este ejemplo.

# --------------------------------------------------------------------------- #
# Base de datos: Google Sheets (la misma planilla de siempre)
# --------------------------------------------------------------------------- #
# La app escribe en pestañas propias con prefijo `cc_` (cc_usuarios, cc_gastos…),
# así no pisa las pestañas viejas `Gastos` y `Lista_Compras`.
sheet_url_gastos = "https://docs.google.com/spreadsheets/d/XXXX/edit"

# --------------------------------------------------------------------------- #
# Cifrado de los datos guardados (OBLIGATORIO en producción)
# --------------------------------------------------------------------------- #
# Generá una clave con:  python tools/generar_clave.py
# Si la perdés, los datos ya cifrados no se pueden recuperar.
# Guardala también fuera del servidor (gestor de contraseñas).
clave_cifrado = "PEGAR_ACA_LA_CLAVE_GENERADA"

# --------------------------------------------------------------------------- #
# Comprobantes (opcional)
# --------------------------------------------------------------------------- #
# Tres opciones, en este orden de prioridad si no se fuerza `medios`:
#   1) imgbb  -> si está `imgbb_api_key` (el servicio de la versión 1).
#   2) drive  -> si está `drive_carpeta_id` (privado, en tu Drive).
#   3) local  -> disco del servidor (en Streamlit Cloud es efímero: se pierden
#                las fotos al reiniciar).
#
# imgbb: la imagen queda con link público-no-listado (quien tenga la URL la ve).
# Es el modo que ya venían usando, así que migrar no requiere tocar nada más.
imgbb_api_key = "tu-api-key-de-imgbb"

# Google Drive (alternativa privada): compartí la carpeta con el client_email de
# la service account como Editor y poné su ID acá. Si además definís
# `medios = "drive"`, Drive gana sobre imgbb.
# drive_carpeta_id = "1AbC..."

# Forzar un backend en particular (opcional): "imgbb" | "drive" | "local".
# medios = "imgbb"

# --------------------------------------------------------------------------- #
# Administración del servicio
# --------------------------------------------------------------------------- #
# Estos emails ven el panel de plataforma (métricas, planes, habilitar cuentas).
admins = ["tu-email@ejemplo.com"]
soporte_email = "hola@cuentasclaras.app"

# Dirección pública de la app: es el link que va en el mensaje de invitación.
# Ya viene con la de este despliegue; sólo hace falta si cambiás de dominio o si
# desplegás una copia para otra persona.
# url_publica = "https://litoral825.streamlit.app"

# Registro abierto a cualquiera. Poné false si vendés con invitación.
registro_abierto = true

# --------------------------------------------------------------------------- #
# Precios (sólo se muestran; el cobro se coordina a mano)
# --------------------------------------------------------------------------- #
precio_mensual = "4.900"
precio_anual = "49.000"
moneda = "ARS"
simbolo = "$"

# --------------------------------------------------------------------------- #
# Ajustes finos
# --------------------------------------------------------------------------- #
# prefijo_hojas = "cc_"
# historial_gratis_meses = 12
# max_comprobante_mb = 5
# cifrado = true
# almacen = "sheets"        # "sqlite" sólo para pruebas locales

# --------------------------------------------------------------------------- #
# Google: cuenta de servicio (SIEMPRE AL FINAL, es la única sección)
# --------------------------------------------------------------------------- #
[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "xxxx"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "cuentas-claras@tu-proyecto.iam.gserviceaccount.com"
client_id = "123456789"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
